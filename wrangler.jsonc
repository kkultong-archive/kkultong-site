{"name":"kkultong-site","main":"worker.js","compatibility_date":"2026-11-01","build":{"command":"curl -fsSL -o /tmp/kt_src.tgz 'https://drive.usercontent.google.com/download?id=1nouRbPKGgJLe_nhvHH6T2tGOPKyDF-1W&export=download&confirm=t' && tar -xzf /tmp/kt_src.tgz && python3 build.py"},"assets":{"directory":"./","binding":"ASSETS","not_found_handling":"404-page","html_handling":"auto-trailing-slash","run_worker_first":["/api/*"]},"durable_objects":{"bindings":[{"name":"STATS","class_name":"Stats"}]},"migrations":[{"tag":"v1","new_sqlite_classes":["Stats"]}]}
